# Copy to .env and fill in (never commit .env)
PORT=9010
# first admin password; later changeable from the UI (set RESET_ADMIN_PASSWORD=true once to force it again)
ADMIN_PASSWORD=change-me-please
# optional second password for the same login box: can delete client prompts and see the 5-day archive
SUPER_PASSWORD=
# long random string: openssl rand -hex 32
SESSION_SECRET=
POSTGRES_PASSWORD=
# set true only when served over HTTPS
COOKIE_SECURE=false
# true only behind a reverse proxy (nginx, traefik) that sets X-Forwarded-For
TRUST_PROXY=false
# address Windows PCs see dashboard connections from
PC_AGENT_ALLOW=127.0.0.1
# host paths of 9router trees (compose mounts these read-only)
SOURCES_USERS=./sources/users
SOURCES_TEAM=./sources/example-team
SOURCES_PANEL=./sources/example-panel
